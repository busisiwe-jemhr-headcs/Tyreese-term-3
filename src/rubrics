// ───────────── Parallel question sets ─────────────
// Every quest has a second version of each question that tests the same outcome.
// Each attempt picks, for every question, the version he has seen LESS often (random when equal),
// so retakes are never the same paper twice in a row.
export function buildSet(test, seen) {
  const RA = RUBRICS[test.id], RB = VARIANTS[test.id];
  const questions = [], rubrics = [], picks = [];
  test.questions.forEach((qa, i) => {
    let p = 'A';
    if (RA && RB && RB[i]) {
      const a = seen?.A?.[i] || 0, b = seen?.B?.[i] || 0;
      p = a < b ? 'A' : b < a ? 'B' : (Math.random() < 0.5 ? 'A' : 'B');
    }
    picks.push(p);
    questions.push(p === 'A' ? qa : { q: RB[i].q, memo: RB[i].memo });
    rubrics.push(p === 'A' ? (RA ? RA[i] : null) : RB[i].r);
  });
  return { questions, rubrics, picks };
}
export function questionsFor(test, picks) {
  const RB = VARIANTS[test.id];
  return test.questions.map((qa, i) => (picks && picks[i] === 'B' && RB && RB[i]) ? { q: RB[i].q, memo: RB[i].memo } : qa);
}
export function recordSeen(seen, picks) {
  const n = picks.length;
  const out = { A: Array.from({ length: n }, (_, i) => seen?.A?.[i] || 0), B: Array.from({ length: n }, (_, i) => seen?.B?.[i] || 0) };
  picks.forEach((p, i) => { out[p][i] += 1; });
  return out;
}
